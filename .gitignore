!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/tests
vitest.config.ts

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (keep .env.example for setup template)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# internal docs & notes (dev only — jangan kirim ke client)
/docs/
PRD.md
AGENTS.md
CLAUDE.md
tasks.md
.tasks.md
data-vps.md

# dev / one-off scripts (bukan bagian source production)
scripts/apply-*.mjs
scripts/diagnose-*.mjs
scripts/db-seed-staff-demo.mjs

# user uploads (local storage)
/src/uploaded/
